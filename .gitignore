# Raw and normalized videos stay local (privacy and size)
data/*
!data/.gitkeep
# Map tiles for Bali (npm run tiles, OpenStreetMap via Protomaps): committed so the hosted map is served
# from the CDN without fetching anything at run time.
!data/tiles/
fixtures/*.mp4

# Model weights
*.pt
# The AGA detector (our own model, trained from scratch, 49 MB) ships with the repo
!models/AGA_Model_cctv6.pt
*.onnx
# The same model as ONNX (tools/export_aga_onnx.py), so the hosted site runs AGA without torch
!models/AGA_Model_cctv6.onnx
*.engine

# API keys for the free assistant (Groq / NVIDIA): never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc

# Node / Vite
node_modules/
web/dist/
*.tsbuildinfo

# Impeccable review captures (regenerated each review)
.impeccable/review/

# OS / editors
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Vercel: build copies web/dist here for the CDN; local Vercel CLI state
/public/
.vercel/
